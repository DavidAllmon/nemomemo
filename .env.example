# NemoMemo configuration — copy to `.env` and edit.
#
#   cp .env.example .env
#
# Every setting here is OPTIONAL. NemoMemo runs with an empty file, or none at
# all: the reef works, Dory forgets, search finds things. Uncomment only what
# you want.
#
# Docker / Compose:  docker compose up -d          (with `env_file: [.env]`)
#                    docker run --env-file .env ...
# Install script:    NEMOMEMO_ENV_FILE=.env curl -fsSL https://trynemomemo.com/install.sh | sh
# From source:       set -a; . ./.env; set +a; node server/dist/index.js
#
# Never commit your filled-in `.env` — it is gitignored for a reason. The
# placeholders below are fake; replace them with your own values.


# ─────────────────────────────────────────────────────────────────────────────
# Where things live
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  DOCKER AND COMPOSE USERS: leave all three of these alone. The image already
#     sets them correctly (/app/data, /app/web-dist, port 5230), and overriding
#     NEMOMEMO_DATA to a relative path would write your memos OUTSIDE the
#     mounted volume — they would vanish the next time the container is
#     recreated. To serve on a different host port, change the port mapping
#     instead (`-p 8080:5230`, or `ports: ["8080:5230"]`), not this value.
#
#     They are here for FROM-SOURCE installs only.

# Port the app listens on. `PORT` also works — Render, Koyeb, Railway and Fly
# inject it automatically, and NemoMemo picks it up with no config from you.
#NEMOMEMO_PORT=5230

# Data directory: holds nemomemo.db (SQLite) and uploads/. Back this up.
#NEMOMEMO_DATA=./data

# Path to the built web app. Source installs need this; the image sets it.
#NEMOMEMO_WEB_DIST=web/dist


# ─────────────────────────────────────────────────────────────────────────────
# Dory
# ─────────────────────────────────────────────────────────────────────────────
# Default lifespan of a Dory memo, in seconds (86400 = 24 hours). Per-memo
# windows in the editor (1h / 24h / 3d / 7d) are unaffected by this. Handy for
# testing: DORY_TTL_SECONDS=60 lets you watch a memo swim away.
#DORY_TTL_SECONDS=86400


# ─────────────────────────────────────────────────────────────────────────────
# Email  (optional — password resets, verification, reminder notifications)
# ─────────────────────────────────────────────────────────────────────────────
# All FOUR of HOST, USER, PASS and FROM are required together. Set three and
# email stays off, silently — NemoMemo keeps working without mail, so there is
# no error to see. Any SMTP provider works (Brevo, Postmark, SES, Fastmail…).
#NEMOMEMO_SMTP_HOST=smtp.example.com
#NEMOMEMO_SMTP_USER=your-smtp-username
#NEMOMEMO_SMTP_PASS=your-smtp-password-or-api-key
#NEMOMEMO_SMTP_FROM=NemoMemo <no-reply@your.domain>

# 587 is STARTTLS (the default). 465 switches to implicit TLS.
#NEMOMEMO_SMTP_PORT=587


# ─────────────────────────────────────────────────────────────────────────────
# Image text search (OCR)  — ON by default, no key needed
# ─────────────────────────────────────────────────────────────────────────────
# Text inside image attachments becomes searchable, so screenshots, whiteboards
# and receipts turn up in search. Runs locally via tesseract.js — nothing
# leaves your machine. Set to 0 (or false) to turn it off; on a Raspberry Pi
# you may prefer that.
#NEMOMEMO_OCR=1

# Comma-separated tesseract language codes. Language data downloads on first
# use and is cached in your data directory.
# Codes: https://tesseract-ocr.github.io/tessdoc/Data-Files-in-different-versions.html
#NEMOMEMO_OCR_LANGS=eng


# ─────────────────────────────────────────────────────────────────────────────
# Voice memo transcripts  (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Point at any OpenAI-compatible /audio/transcriptions endpoint and recorded
# voice memos get a transcript shown under the player — and become searchable.
# Setting the URL is what turns this on.
#
# OpenAI:
#NEMOMEMO_TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
#NEMOMEMO_TRANSCRIBE_KEY=sk-your-openai-key
#NEMOMEMO_TRANSCRIBE_MODEL=whisper-1
#
# …or your own hardware (whisper.cpp, LocalAI, Speaches). Leave the key unset
# for a keyless local server:
#NEMOMEMO_TRANSCRIBE_URL=http://localhost:8080/v1/audio/transcriptions


# ─────────────────────────────────────────────────────────────────────────────
# Live dictation  (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Tap the mic and words stream into the editor as you speak, via the OpenAI
# Realtime API. Setting a key turns it on and adds the mic's dropdown menu;
# without it the mic still records voice memos.
#
# Your key never reaches the browser — the server mints a short-lived
# session key per dictation, capped at 20 per 10 minutes per IP. That stops a
# script, but audio streams from the browser straight to OpenAI, so if your reef
# is open to the public, put a budget on the OpenAI project as well.
#NEMOMEMO_DICTATE_KEY=sk-your-openai-key
#NEMOMEMO_DICTATE_MODEL=gpt-live-transcribe

# ---------------------------------------------------------------------------
# Capture from Telegram (optional)
# ---------------------------------------------------------------------------
# Message a bot and it becomes a memo — text, photos, and voice notes, with
# #tags working inline. Create a bot by messaging @BotFather on Telegram, then
# paste the token it gives you here and restart.
#
# Each member connects their own chat from Settings -> Access, so one bot
# serves everyone on the reef without them sharing anything.
#
# Note: messages to a bot travel through Telegram's servers and are NOT
# end-to-end encrypted. Fine for "buy milk"; think twice for secrets.
#NEMOMEMO_TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather
