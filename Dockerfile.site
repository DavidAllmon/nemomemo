FROM node:22-slim AS build
WORKDIR /app
RUN npm i -g pnpm@11
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
RUN node -e "const fs=require('fs'); const p=require('./package.json'); p.packageManager='pnpm@11.22.0'; fs.writeFileSync('package.json', JSON.stringify(p))"
COPY site/package.json site/
RUN pnpm install --frozen-lockfile --filter @nemomemo/site
COPY site/ site/
WORKDIR /app/site
ARG NEXT_PUBLIC_DEMO_URL
ENV NEXT_PUBLIC_DEMO_URL=$NEXT_PUBLIC_DEMO_URL
ARG NEXT_PUBLIC_CLOUD_URL
ENV NEXT_PUBLIC_CLOUD_URL=$NEXT_PUBLIC_CLOUD_URL
RUN pnpm build

FROM nginx:alpine
COPY --from=build /app/site/out /usr/share/nginx/html
COPY nginx-site.conf /etc/nginx/conf.d/default.conf
