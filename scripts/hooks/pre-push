#!/usr/bin/env bash
# Blocks pushing app-code changes to main without a version bump + changelog entry.
# Enable once per clone:  git config core.hooksPath scripts/hooks
set -euo pipefail

remote_sha=$(git ls-remote origin refs/heads/main | cut -f1)
[[ -z $remote_sha ]] && exit 0
# Nothing to compare against locally (fresh clone edge case) — let it through.
git cat-file -e "$remote_sha" 2>/dev/null || exit 0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [[ $remote_ref == refs/heads/main ]] || continue
  changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)
  echo "$changed" | grep -qE '^(shared/|server/|web/|Dockerfile$)' || continue

  remote_version=$(git show "$remote_sha:package.json" 2>/dev/null | grep -m1 '"version"' || true)
  local_version=$(git show "$local_sha:package.json" | grep -m1 '"version"')
  if [[ $remote_version == "$local_version" ]]; then
    echo "🐡 App code changed but the version didn't — this push deploys to paying reefs."
    echo "   Run:  pnpm release   (bump + changelog), then push again."
    echo "   Docs/site-only pushes don't need a bump."
    exit 1
  fi
done
exit 0
